# Dhaage Designer Boutique - Environment Configuration
# Copy this file to .env and update values

# Server
PORT=5000
NODE_ENV=development

# JWT Secret - use a long random string in production
JWT_SECRET=dhaage-super-secret-key-change-this-in-production

# WhatsApp Business number (with country code, digits only)
WHATSAPP_NUMBER=919923267780

# Admin credentials (used to create default admin on first run)
ADMIN_EMAIL=admin@dhaage.com
ADMIN_PASSWORD=admin123

# ===== Razorpay Payment Gateway =====
# TEST MODE KEYS (from https://dashboard.razorpay.com/app/keys)
# 1. Sign up / login at https://dashboard.razorpay.com
# 2. Go to Settings → API Keys → Generate Test Key
# 3. Copy the Key ID and Key Secret below (Test Mode)
# 4. NEVER share your Key Secret or commit it to GitHub.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Webhook secret (Settings → Webhooks → Add Webhook)
# URL: https://YOUR_DOMAIN/api/payments/webhook
# Events: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=

