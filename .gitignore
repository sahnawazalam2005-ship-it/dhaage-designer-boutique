# ============================================================
# Dhaage Designer Boutique — .gitignore
# Protects secrets, data, uploads, and build artifacts from
# ever being committed to Git / GitHub.
# ============================================================

# ---- Dependencies ----
node_modules/
server/node_modules/
client/node_modules/

# ---- Build output ----
client/dist/
dist/
build/

# ---- Environment files (SECRETS — never commit) ----
# Blocks all .env variants, while keeping the example template.
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# ---- SQLite database files (customer/order/admin data) ----
server/data/*.db
server/data/*.db-journal
server/data/*.db-wal
server/data/*.db-shm
server/data/*.db-*
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- Uploaded product & banner images (never commit) ----
server/uploads/
server/uploads/*

# ---- Logs ----
*.log
server.log
server/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Backups ----
backups/
.backup-*/
*.bak
*.bak-*
*.backup
*.tar.gz
*.zip
*.sqlite
*.sqlite3

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

